<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_Norm180" Id="{c53d1ae6-8271-4231-8ffd-61f6a721f32f}" SpecialFunc="None">
    <Declaration><![CDATA[// =============================================================
// FUNCTION：F_Norm180
// =============================================================
FUNCTION F_Norm180 : LREAL
VAR_INPUT
    Ang_deg : LREAL;
END_VAR
VAR
    a : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[

a := Ang_deg;

WHILE a > 180.0 DO
    a := a - 360.0;
END_WHILE;

WHILE a < -180.0 DO
    a := a + 360.0;
END_WHILE;

F_Norm180 := a;
]]></ST>
    </Implementation>
    <LineIds Name="F_Norm180">
      <LineId Id="41" Count="12" />
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>